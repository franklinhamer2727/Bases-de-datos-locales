# Copie a .env. Password del admin: 8+ caracteres, MAYUS y minus, al menos 1 digito.
CB_ADMIN_NAME=cbadmin
CB_ADMIN_PASSWORD=CbAdmin_2026.Dev
CB_SERVER_NAME=DBeaver BSG
CB_PORT=8978
TZ=America/Lima

# Memoria (ligero). Suba -Xmx si abre resultados muy grandes.
CONTAINER_MEMORY=1g
CB_JAVA_OPTS=-Xms128m -Xmx768m -XX:+UseSerialGC

# Opcional: fijar version en vez de latest (p.ej. dbeaver/cloudbeaver:25.3.5)
# CB_IMAGE=dbeaver/cloudbeaver:latest
