# Configuracion fija (los tamanos de memoria van en docker-compose.yml / .env)
[mysqld]
character-set-server = utf8mb4
collation-server     = utf8mb4_0900_ai_ci
default-time-zone    = '-05:00'        # Lima, sin horario de verano
skip-name-resolve                      # evita lentitud por DNS inverso al conectar
local_infile         = 0
slow_query_log       = 1
long_query_time      = 1
log_error_verbosity  = 2

[client]
default-character-set = utf8mb4
