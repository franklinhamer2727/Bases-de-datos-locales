# Copie este archivo a .env y ajuste los valores.
# Evite '$' en las passwords (docker compose lo interpreta) y espacios/#.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=PgDev_2026.Admin
PG_PORT=5432
TZ=America/Lima

APP_DB=GNBPE_DATAHUB
APP_USER=datahub
APP_PASSWORD=DataHub_2026.App

# Recursos (desarrollo)
CONTAINER_MEMORY=4g
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=2GB
PG_WORK_MEM=16MB
PG_MAX_CONNECTIONS=100
PG_LOG_SLOW_MS=1000

# pgAdmin (docker compose --profile tools up -d)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=PgAdmin_2026
PGADMIN_PORT=5050

# Opcional: otra version de Postgres (ojo: postgres:18 cambia la ruta del volumen)
# PG_IMAGE=postgres:17-bookworm
