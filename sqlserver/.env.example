# Copie este archivo a .env y ajuste los valores.
# Passwords: 8+ caracteres y 3 de 4 grupos (MAYUS, minus, digito, simbolo).
# Evite en las passwords: $  (docker compose lo interpreta),  '  (rompe el T-SQL),
# espacios y #.

MSSQL_SA_PASSWORD=SqlDev_2026.Sa
MSSQL_PID=Developer
MSSQL_PORT=1433
MSSQL_MEMORY_LIMIT_MB=2048
CONTAINER_MEMORY=4g
TZ=America/Lima

APP_DB=GNBPE_DATAHUB
APP_USER=datahub
APP_PASSWORD=DataHub_2026.App

# Opcional: fijar un CU concreto en vez de 2022-latest
# MSSQL_IMAGE=mcr.microsoft.com/mssql/server:2022-CU16-ubuntu-22.04
